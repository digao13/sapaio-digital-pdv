<UserControl x:Class="SapaioDigital.App.Views.ProdutosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="360"/>
        </Grid.ColumnDefinitions>

        <!-- Lista de Produtos -->
        <Border Grid.Column="0" Background="White" CornerRadius="8" Padding="16" Margin="0,0,16,0" BorderBrush="#E2E8F0" BorderThickness="1">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                    <TextBox x:Name="TxtBusca" Width="280" ToolTip="Buscar por nome ou código de barras" TextChanged="TxtBusca_TextChanged"/>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="+ Entrada Estoque" Style="{StaticResource SuccessButton}" Margin="0,0,8,0" Click="BtnEntrada_Click"/>
                        <Button Content="- Saída Estoque" Style="{StaticResource DangerButton}" Click="BtnSaida_Click"/>
                    </StackPanel>
                </DockPanel>

                <DataGrid x:Name="GridProdutos" SelectionChanged="GridProdutos_SelectionChanged">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50"/>
                        <DataGridTextColumn Header="Nome do Produto" Binding="{Binding Nome}" Width="*"/>
                        <DataGridTextColumn Header="Cód. Barras" Binding="{Binding CodigoBarras}" Width="130"/>
                        <DataGridTextColumn Header="Qtd" Binding="{Binding Quantidade}" Width="70"/>
                        <DataGridTextColumn Header="Unid." Binding="{Binding Unidade}" Width="55"/>
                        <DataGridTextColumn Header="Preço Venda" Binding="{Binding PrecoVenda, StringFormat=R$ {0:N2}}" Width="105"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>

        <!-- Formulário de Cadastro / Edição + Movimentação -->
        <StackPanel Grid.Column="1">
            <Border Background="White" CornerRadius="8" Padding="18" BorderBrush="#E2E8F0" BorderThickness="1" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock x:Name="TxtTituloForm" Text="Novo Produto" FontSize="16" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,12"/>

                    <TextBlock Text="Nome do Produto *" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4"/>
                    <TextBox x:Name="TxtNome" Margin="0,0,0,10"/>

                    <TextBlock Text="Código de Barras (opcional)" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4"/>
                    <TextBox x:Name="TxtCodigoBarras" Margin="0,0,0,10"/>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Quantidade Inicial *" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4"/>
                            <TextBox x:Name="TxtQuantidade" Text="0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Unidade" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4"/>
                            <TextBox x:Name="TxtUnidade" Text="UN"/>
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Preço Venda (R$) *" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4"/>
                            <TextBox x:Name="TxtPrecoVenda" Text="0,00"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Preço Custo (R$)" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4"/>
                            <TextBox x:Name="TxtPrecoCusto" Text="0,00"/>
                        </StackPanel>
                    </Grid>

                    <StackPanel Orientation="Horizontal">
                        <Button Content="Salvar Produto" Style="{StaticResource PrimaryButton}" Click="BtnSalvar_Click" Margin="0,0,8,0"/>
                        <Button Content="Limpar / Novo" Style="{StaticResource SecondaryButton}" Click="BtnLimpar_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Painel Rápido de Entrada / Saída -->
            <Border x:Name="PanelMovimentacao" Background="White" CornerRadius="8" Padding="18" BorderBrush="#E2E8F0" BorderThickness="1" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock x:Name="TxtTituloMov" Text="Entrada de Estoque" FontSize="15" FontWeight="Bold" Margin="0,0,0,8"/>
                    <TextBlock x:Name="TxtProdutoMov" Text="" FontWeight="SemiBold" Foreground="#2563EB" Margin="0,0,0,10" TextWrapping="Wrap"/>

                    <TextBlock Text="Quantidade *" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4"/>
                    <TextBox x:Name="TxtQtdMov" Text="1" Margin="0,0,0,10"/>

                    <TextBlock Text="Motivo / Observação" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4"/>
                    <TextBox x:Name="TxtMotivoMov" Margin="0,0,0,12"/>

                    <StackPanel Orientation="Horizontal">
                        <Button Content="Confirmar" Style="{StaticResource SuccessButton}" Click="BtnConfirmarMov_Click" Margin="0,0,8,0"/>
                        <Button Content="Cancelar" Style="{StaticResource SecondaryButton}" Click="BtnCancelarMov_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>

<UserControl x:Class="SapaioDigital.App.Views.OrcamentosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="0.42*" MinWidth="360" MaxWidth="490"/>
            <ColumnDefinition Width="0.58*" MinWidth="420"/>
        </Grid.ColumnDefinitions>

        <!-- FormulÃ¡rio de OrÃ§amento / OS -->
        <Border Grid.Column="0" Background="{DynamicResource BgCardBrush}" CornerRadius="8" Padding="16" Margin="0,0,14,0" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- CabeÃ§alho com Info da Loja -->
                    <Border Background="{DynamicResource BgSubtleBrush}" CornerRadius="6" Padding="10" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Margin="0,0,0,12">
                        <DockPanel>
                            <Border Width="58" Height="46" ClipToBounds="True" CornerRadius="4" Background="{DynamicResource BgCardBrush}" Margin="0,0,10,0">
                                <Image x:Name="ImgLojaLogo" MaxWidth="54" MaxHeight="42" Stretch="Uniform"
                                       RenderOptions.BitmapScalingMode="HighQuality" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="TxtLojaNome" Text="Sapaio Digital" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource TextMainBrush}" TextWrapping="Wrap"/>
                                <TextBlock x:Name="TxtLojaTel" Text="Tel:" FontSize="11.5" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <TextBlock x:Name="TxtTituloForm" Text="Novo OrÃ§amento / Ordem de ServiÃ§o" FontSize="15.5" FontWeight="Bold" Foreground="{DynamicResource TextMainBrush}" TextWrapping="Wrap" Margin="0,0,0,10"/>

                    <TextBlock Text="Cliente *" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4"/>
                    <ComboBox x:Name="CmbCliente" DisplayMemberPath="Nome" SelectedValuePath="Id" Margin="0,0,0,10"/>

                    <TextBlock Text="Equipamento / Dispositivo (InformÃ¡tica)" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4"/>
                    <TextBox x:Name="TxtEquipamento" Margin="0,0,0,10" ToolTip="Ex: Notebook Acer Aspire, PC Gamer, Impressora Epson"/>

                    <TextBlock Text="Problema Relatado *" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4"/>
                    <TextBox x:Name="TxtProblema" Height="68" TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top" Margin="0,0,0,10"/>

                    <TextBlock Text="ServiÃ§os Previstos / PeÃ§as / ObservaÃ§Ãµes" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4"/>
                    <TextBox x:Name="TxtServicos" Height="60" TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top" Margin="0,0,0,10"/>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Valor Estimado (R$)" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4"/>
                            <TextBox x:Name="TxtValor" Text="0,00"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Status" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4"/>
                            <ComboBox x:Name="CmbStatus">
                                <ComboBoxItem Content="Aberto" IsSelected="True"/>
                                <ComboBoxItem Content="Aprovado"/>
                                <ComboBoxItem Content="Em ServiÃ§o"/>
                                <ComboBoxItem Content="ConcluÃ­do"/>
                                <ComboBoxItem Content="Cancelado"/>
                            </ComboBox>
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Data e Hora" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4"/>
                            <DatePicker x:Name="DpData"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="ResponsÃ¡vel (Conectado)" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4"/>
                            <TextBox x:Name="TxtResponsavel" IsReadOnly="True" Background="{DynamicResource BgMainBrush}" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Grid>

                    <WrapPanel>
                        <Button Content="Salvar OS" Style="{StaticResource PrimaryButton}" Click="BtnSalvar_Click" Margin="0,0,8,8"/>
                        <Button Content="Salvar e Imprimir PDF" Style="{StaticResource SuccessButton}" Click="BtnSalvarImprimir_Click" Margin="0,0,8,8"/>
                        <Button Content="Nova OS" Style="{StaticResource SecondaryButton}" Click="BtnLimpar_Click" Margin="0,0,0,8"/>
                    </WrapPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Lista de OrÃ§amentos / OS -->
        <Border Grid.Column="1" Background="{DynamicResource BgCardBrush}" CornerRadius="8" Padding="16" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
            <DockPanel>
                <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                    <TextBox x:Name="TxtBusca" Width="220" Margin="0,0,8,4" ToolTip="Buscar por cliente, equipamento ou problema" TextChanged="TxtBusca_TextChanged"/>
                    <Button Content="ðŸ–¨ï¸ Imprimir PDF Selecionada" Style="{StaticResource SecondaryButton}" Margin="0,0,0,4" Click="BtnImprimirSelecionada_Click"/>
                </WrapPanel>

                <DataGrid x:Name="GridOrcamentos" SelectionChanged="GridOrcamentos_SelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Auto">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="OS #" Binding="{Binding Id, StringFormat=D5}" Width="60"/>
                        <DataGridTextColumn Header="Data/Hora" Binding="{Binding DataHora, StringFormat=dd/MM/yyyy HH:mm}" Width="118"/>
                        <DataGridTextColumn Header="Cliente" Binding="{Binding ClienteNome}" Width="*" MinWidth="120"/>
                        <DataGridTextColumn Header="Equipamento" Binding="{Binding Equipamento}" Width="120"/>
                        <DataGridTextColumn Header="ResponsÃ¡vel" Binding="{Binding UsuarioNome}" Width="110"/>
                        <DataGridTextColumn Header="Valor" Binding="{Binding ValorEstimado, StringFormat=R$ {0:N2}}" Width="90"/>
                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="85"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>

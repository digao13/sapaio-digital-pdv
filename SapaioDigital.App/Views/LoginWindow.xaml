<Window x:Class="SapaioDigital.App.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Acesso ao Sistema - Sapaio Digital"
        Height="410" Width="400"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#F1F5F9">
    <Border Margin="24" Background="White" CornerRadius="10" Padding="24" BorderBrush="#E2E8F0" BorderThickness="1">
        <StackPanel VerticalAlignment="Center">
            <Image x:Name="ImgLogo" Height="64" Stretch="Uniform" Margin="0,0,0,10"/>
            <TextBlock x:Name="TxtNomeLoja" Text="Sapaio Digital" FontSize="19" FontWeight="Bold" HorizontalAlignment="Center" Foreground="#0F172A"/>
            <TextBlock Text="Faça login para continuar" FontSize="12.5" Foreground="#64748B" HorizontalAlignment="Center" Margin="0,2,0,18"/>

            <TextBlock Text="Usuário (Login)" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4"/>
            <TextBox x:Name="TxtLogin" Margin="0,0,0,12"/>

            <TextBlock Text="Senha" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4"/>
            <PasswordBox x:Name="TxtSenha" Margin="0,0,0,18" KeyDown="TxtSenha_KeyDown"/>

            <Button Content="Entrar" Style="{StaticResource PrimaryButton}" Height="38" FontSize="14" Click="BtnEntrar_Click"/>
        </StackPanel>
    </Border>
</Window>

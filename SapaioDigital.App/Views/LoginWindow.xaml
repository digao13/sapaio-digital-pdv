<Window x:Class="SapaioDigital.App.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Acesso ao Sistema - Sapaio Digital"
        Width="440" SizeToContent="Height" MinWidth="380"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize"
        FontFamily="Segoe UI Variable, Segoe UI, Arial"
        Background="{DynamicResource BgMainBrush}"
        Foreground="{DynamicResource TextMainBrush}">
    <Border Margin="22" Background="{DynamicResource BgCardBrush}" CornerRadius="18" Padding="26" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
        <StackPanel>
            <Border MaxHeight="84" MaxWidth="220" ClipToBounds="True" HorizontalAlignment="Center" Margin="0,0,0,12">
                <Image x:Name="ImgLogo" MaxHeight="80" MaxWidth="210" Stretch="Uniform"
                       RenderOptions.BitmapScalingMode="HighQuality" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <TextBlock x:Name="TxtNomeLoja" Text="Sapaio Digital" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" Foreground="{DynamicResource TextMainBrush}"/>
            <TextBlock Text="Faça login para continuar" FontSize="12.5" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center" Margin="0,4,0,20"/>

            <TextBlock Text="Usuário (Login)" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextMainBrush}" Margin="0,0,0,5"/>
            <TextBox x:Name="TxtLogin" Height="38" Margin="0,0,0,14"/>

            <TextBlock Text="Senha" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextMainBrush}" Margin="0,0,0,5"/>
            <PasswordBox x:Name="TxtSenha" Height="38" Margin="0,0,0,20" KeyDown="TxtSenha_KeyDown"/>

            <Button Content="Entrar" Style="{StaticResource PrimaryButton}" Height="42" FontSize="14" Click="BtnEntrar_Click"/>
        </StackPanel>
    </Border>
</Window>

<Window x:Class="SapaioDigital.App.Views.OnboardingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Configuração Inicial Obrigatória - Sapaio Digital"
        Height="620" Width="620"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#F1F5F9">
    <Border Margin="24" Background="White" CornerRadius="10" Padding="26" BorderBrush="#E2E8F0" BorderThickness="1">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Bem-vindo ao Sapaio Digital" FontSize="22" FontWeight="Bold" Foreground="#0F172A"/>
                <TextBlock Text="Antes de operar o sistema, informe os dados obrigatórios da sua loja (que sairão nas Ordens de Serviço e no PDV) e o usuário administrador."
                           TextWrapping="Wrap" Foreground="#64748B" Margin="0,6,0,18" FontSize="13"/>

                <TextBlock Text="1. Dados da Loja" FontWeight="Bold" FontSize="14" Foreground="#1E293B" Margin="0,0,0,8"/>

                <TextBlock Text="Razão Social / Nome da Loja *" FontWeight="SemiBold" FontSize="12" Margin="0,4,0,4"/>
                <TextBox x:Name="TxtRazaoSocial" Text="Sapaio Digital" Margin="0,0,0,10"/>

                <TextBlock Text="Telefone / WhatsApp da Loja *" FontWeight="SemiBold" FontSize="12" Margin="0,4,0,4"/>
                <TextBox x:Name="TxtTelefone" Margin="0,0,0,10"/>

                <TextBlock Text="Logo / Foto da Loja *" FontWeight="SemiBold" FontSize="12" Margin="0,4,0,4"/>
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="96"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="88" Height="72" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Background="#F8FAFC">
                        <Image x:Name="ImgLogoPreview" Stretch="Uniform" Margin="4"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
                        <Button Content="Selecionar Foto / Logo..." Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Click="BtnSelecionarLogo_Click"/>
                        <TextBlock x:Name="TxtLogoArquivo" Text="Nenhuma imagem selecionada" FontSize="11.5" Foreground="#64748B" Margin="0,6,0,0" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Grid>

                <Separator Margin="0,4,0,14"/>

                <StackPanel x:Name="PanelAdmin">
                    <TextBlock Text="2. Usuário Administrador Inicial" FontWeight="Bold" FontSize="14" Foreground="#1E293B" Margin="0,0,0,8"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Nome Completo *" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4"/>
                            <TextBox x:Name="TxtAdminNome" Margin="0,0,0,10"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Login de Acesso *" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4"/>
                            <TextBox x:Name="TxtAdminLogin" Text="admin" Margin="0,0,0,10"/>
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="Senha *" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4"/>
                    <PasswordBox x:Name="TxtAdminSenha" Margin="0,0,0,14"/>
                </StackPanel>

                <Button Content="Salvar e Começar a Operar" Style="{StaticResource SuccessButton}" Height="40" FontSize="14" Click="BtnSalvar_Click"/>
            </StackPanel>
        </ScrollViewer>
    </Border>
</Window>

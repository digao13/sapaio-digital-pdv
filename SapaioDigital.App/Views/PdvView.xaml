<UserControl x:Class="SapaioDigital.App.Views.PdvView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="400"/>
        </Grid.ColumnDefinitions>

        <!-- Lado Esquerdo: Cabeçalho Loja + Busca/Leitor + Carrinho -->
        <Grid Grid.Column="0" Margin="0,0,16,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Info da Loja no PDV -->
            <Border Grid.Row="0" Background="White" CornerRadius="8" Padding="14" Margin="0,0,0,12" BorderBrush="#E2E8F0" BorderThickness="1">
                <DockPanel>
                    <Image x:Name="ImgLojaLogo" Width="56" Height="44" Stretch="Uniform" Margin="0,0,12,0"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="TxtLojaNome" Text="Sapaio Digital" FontSize="17" FontWeight="Bold" Foreground="#0F172A"/>
                        <TextBlock x:Name="TxtLojaTel" Text="Tel:" FontSize="12" Foreground="#64748B"/>
                    </StackPanel>
                    <TextBlock DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center"
                               Text="CAIXA ABERTO" FontWeight="Bold" FontSize="13" Foreground="#16A34A"/>
                </DockPanel>
            </Border>

            <!-- Leitor de Código de Barras / Busca Rápida -->
            <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="14" Margin="0,0,0,12" BorderBrush="#E2E8F0" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="90"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                        <TextBlock Text="Código de Barras ou Nome do Produto (Enter para adicionar)" FontSize="11.5" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4"/>
                        <TextBox x:Name="TxtBuscaProduto" FontSize="14" KeyDown="TxtBuscaProduto_KeyDown" TextChanged="TxtBuscaProduto_TextChanged"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,0,10,0">
                        <TextBlock Text="Qtd" FontSize="11.5" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4"/>
                        <TextBox x:Name="TxtQtdAdd" Text="1" FontSize="14" TextAlignment="Center"/>
                    </StackPanel>
                    <Button Grid.Column="2" Content="+ Adicionar" Style="{StaticResource PrimaryButton}" VerticalAlignment="Bottom" Height="36" Click="BtnAdicionar_Click"/>
                </Grid>
            </Border>

            <!-- Sugestões de Produtos + Carrinho -->
            <Grid Grid.Row="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="140"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="White" CornerRadius="8" Padding="10" Margin="0,0,0,12" BorderBrush="#E2E8F0" BorderThickness="1">
                    <DataGrid x:Name="GridSugestoes" MouseDoubleClick="GridSugestoes_MouseDoubleClick">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Produto (Duplo clique para adicionar)" Binding="{Binding Nome}" Width="*"/>
                            <DataGridTextColumn Header="Cód. Barras" Binding="{Binding CodigoBarras}" Width="120"/>
                            <DataGridTextColumn Header="Estoque" Binding="{Binding Quantidade}" Width="75"/>
                            <DataGridTextColumn Header="Preço" Binding="{Binding PrecoVenda, StringFormat=R$ {0:N2}}" Width="95"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>

                <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="14" BorderBrush="#E2E8F0" BorderThickness="1">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                            <TextBlock Text="CARRINHO DE COMPRAS" FontWeight="Bold" FontSize="13.5" Foreground="#0F172A"/>
                            <Button DockPanel.Dock="Right" Content="Remover Item" Style="{StaticResource DangerButton}" Padding="10,4" FontSize="11.5" HorizontalAlignment="Right" Click="BtnRemoverItem_Click"/>
                        </DockPanel>
                        <DataGrid x:Name="GridCarrinho">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Produto" Binding="{Binding ProdutoNome}" Width="*"/>
                                <DataGridTextColumn Header="Qtd" Binding="{Binding Quantidade}" Width="60"/>
                                <DataGridTextColumn Header="Vl. Unit" Binding="{Binding PrecoUnitario, StringFormat=R$ {0:N2}}" Width="95"/>
                                <DataGridTextColumn Header="Subtotal" Binding="{Binding Subtotal, StringFormat=R$ {0:N2}}" Width="100"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- Lado Direito: Fechamento da Venda e Impressão -->
        <Border Grid.Column="1" Background="White" CornerRadius="8" Padding="20" BorderBrush="#E2E8F0" BorderThickness="1">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Fechamento da Venda" FontSize="17" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,14"/>

                    <TextBlock Text="Cliente (opcional)" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4"/>
                    <ComboBox x:Name="CmbCliente" DisplayMemberPath="Nome" Margin="0,0,0,12"/>

                    <TextBlock Text="Forma de Pagamento" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4"/>
                    <ComboBox x:Name="CmbPagamento" Margin="0,0,0,12">
                        <ComboBoxItem Content="Dinheiro" IsSelected="True"/>
                        <ComboBoxItem Content="PIX"/>
                        <ComboBoxItem Content="Cartão de Débito"/>
                        <ComboBoxItem Content="Cartão de Crédito"/>
                    </ComboBox>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Desconto (R$)" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4"/>
                            <TextBox x:Name="TxtDesconto" Text="0,00" TextChanged="TxtValores_TextChanged"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Valor Recebido (R$)" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4"/>
                            <TextBox x:Name="TxtRecebido" Text="0,00" TextChanged="TxtValores_TextChanged"/>
                        </StackPanel>
                    </Grid>

                    <!-- Totais -->
                    <Border Background="#0F172A" CornerRadius="8" Padding="16" Margin="0,4,0,14">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,6">
                                <TextBlock Text="Subtotal:" Foreground="#94A3B8" FontSize="13"/>
                                <TextBlock x:Name="TxtSubtotal" Text="R$ 0,00" Foreground="White" FontSize="13" HorizontalAlignment="Right"/>
                            </DockPanel>
                            <DockPanel Margin="0,0,0,8">
                                <TextBlock Text="Troco:" Foreground="#94A3B8" FontSize="13"/>
                                <TextBlock x:Name="TxtTroco" Text="R$ 0,00" Foreground="#38BDF8" FontSize="14" FontWeight="Bold" HorizontalAlignment="Right"/>
                            </DockPanel>
                            <Separator Background="#334155" Margin="0,2,0,8"/>
                            <DockPanel>
                                <TextBlock Text="TOTAL:" Foreground="White" FontSize="18" FontWeight="Bold"/>
                                <TextBlock x:Name="TxtTotal" Text="R$ 0,00" Foreground="#4ADE80" FontSize="22" FontWeight="Bold" HorizontalAlignment="Right"/>
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Impressora Não Fiscal (Bobina)" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4"/>
                    <ComboBox x:Name="CmbImpressora" Margin="0,0,0,8"/>
                    <CheckBox x:Name="ChkImprimirCupom" Content="Imprimir comprovante automaticamente ao finalizar" IsChecked="True" Margin="0,0,0,16"/>

                    <Button Content="✔  FINALIZAR VENDA (F12)" Style="{StaticResource SuccessButton}" Height="46" FontSize="15" Click="BtnFinalizar_Click" Margin="0,0,0,10"/>
                    <Button Content="Limpar Carrinho" Style="{StaticResource SecondaryButton}" Click="BtnLimparCarrinho_Click"/>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>

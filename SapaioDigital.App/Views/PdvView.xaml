<UserControl x:Class="SapaioDigital.App.Views.PdvView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Foreground="{DynamicResource TextMainBrush}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="0.64*" MinWidth="460"/>
            <ColumnDefinition Width="0.36*" MinWidth="330" MaxWidth="460"/>
        </Grid.ColumnDefinitions>

        <!-- Lado Esquerdo: Cabeçalho Loja + Busca/Leitor + Sugestões (só ao pesquisar) + Carrinho -->
        <Grid Grid.Column="0" Margin="0,0,14,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Info da Loja no PDV -->
            <Border Grid.Row="0" Background="{DynamicResource BgCardBrush}" CornerRadius="18" Padding="14" Margin="0,0,0,12" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
                <DockPanel>
                    <Border Width="64" Height="48" ClipToBounds="True" CornerRadius="10" Background="{DynamicResource BgSubtleBrush}" Margin="0,0,12,0">
                        <Image x:Name="ImgLojaLogo" MaxWidth="60" MaxHeight="44" Stretch="Uniform"
                               RenderOptions.BitmapScalingMode="HighQuality" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="TxtLojaNome" Text="Sampaio Digital" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextMainBrush}" TextWrapping="Wrap"/>
                        <TextBlock x:Name="TxtLojaTel" Text="Tel:" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap"/>
                    </StackPanel>
                    <TextBlock DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center"
                               Text="CAIXA ABERTO" FontWeight="SemiBold" FontSize="12.5" Foreground="#16A34A"/>
                </DockPanel>
            </Border>

            <!-- Leitor de Código de Barras / Busca Rápida -->
            <Border Grid.Row="1" Background="{DynamicResource BgCardBrush}" CornerRadius="18" Padding="14" Margin="0,0,0,12" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="75"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <TextBlock Text="Pesquisar Produto por Código de Barras ou Nome (Enter para adicionar)" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}" TextTrimming="CharacterEllipsis" Margin="0,0,0,4"/>
                        <TextBox x:Name="TxtBuscaProduto" FontSize="14" KeyDown="TxtBuscaProduto_KeyDown" TextChanged="TxtBuscaProduto_TextChanged"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,0,8,0">
                        <TextBlock Text="Qtd" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,4"/>
                        <TextBox x:Name="TxtQtdAdd" Text="1" FontSize="14" TextAlignment="Center"/>
                    </StackPanel>
                    <Button Grid.Column="2" Content="+ Adicionar" Style="{StaticResource PrimaryButton}" VerticalAlignment="Bottom" Height="38" Click="BtnAdicionar_Click"/>
                </Grid>
            </Border>

            <!-- Sugestões (só aparece quando o operador digita na pesquisa) -->
            <Border x:Name="BorderSugestoes" Grid.Row="2" Visibility="Collapsed" MaxHeight="165"
                    Background="{DynamicResource BgCardBrush}" CornerRadius="18" Padding="10" Margin="0,0,0,12"
                    BorderBrush="{DynamicResource PrimaryBrush}" BorderThickness="1.5">
                <DataGrid x:Name="GridSugestoes" MouseDoubleClick="GridSugestoes_MouseDoubleClick">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Resultado da Pesquisa (Duplo clique para adicionar)" Binding="{Binding Nome}" Width="*"/>
                        <DataGridTextColumn Header="Cód. Barras" Binding="{Binding CodigoBarras}" Width="110"/>
                        <DataGridTextColumn Header="Estoque" Binding="{Binding Quantidade}" Width="65"/>
                        <DataGridTextColumn Header="Preço" Binding="{Binding PrecoVenda, StringFormat=R$ {0:N2}}" Width="90"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- Carrinho -->
            <Border Grid.Row="3" Background="{DynamicResource BgCardBrush}" CornerRadius="18" Padding="14" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <TextBlock Text="CARRINHO DE COMPRAS" FontWeight="SemiBold" FontSize="13.5" Foreground="{DynamicResource TextMainBrush}" VerticalAlignment="Center"/>
                        <Button DockPanel.Dock="Right" Content="Remover Item" Style="{StaticResource DangerButton}" Padding="12,5" FontSize="11.5" HorizontalAlignment="Right" Click="BtnRemoverItem_Click"/>
                    </DockPanel>
                    <DataGrid x:Name="GridCarrinho">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Produto" Binding="{Binding ProdutoNome}" Width="*"/>
                            <DataGridTextColumn Header="Qtd" Binding="{Binding Quantidade}" Width="55"/>
                            <DataGridTextColumn Header="Vl. Unit" Binding="{Binding PrecoUnitario, StringFormat=R$ {0:N2}}" Width="85"/>
                            <DataGridTextColumn Header="Subtotal" Binding="{Binding Subtotal, StringFormat=R$ {0:N2}}" Width="90"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
        </Grid>

        <!-- Lado Direito: Fechamento da Venda e Impressão -->
        <Border Grid.Column="1" Background="{DynamicResource BgCardBrush}" CornerRadius="18" Padding="20" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Fechamento da Venda" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource TextMainBrush}" Margin="0,0,0,12"/>

                    <TextBlock Text="Cliente (opcional)" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextMainBrush}" Margin="0,0,0,4"/>
                    <ComboBox x:Name="CmbCliente" DisplayMemberPath="Nome" Margin="0,0,0,10"/>

                    <TextBlock Text="Forma de Pagamento" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextMainBrush}" Margin="0,0,0,4"/>
                    <ComboBox x:Name="CmbPagamento" Margin="0,0,0,10">
                        <ComboBoxItem Content="Dinheiro" IsSelected="True"/>
                        <ComboBoxItem Content="PIX"/>
                        <ComboBoxItem Content="Cartão de Débito"/>
                        <ComboBoxItem Content="Cartão de Crédito"/>
                    </ComboBox>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Desconto (R$)" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextMainBrush}" Margin="0,0,0,4"/>
                            <TextBox x:Name="TxtDesconto" Text="0,00" TextChanged="TxtValores_TextChanged"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Valor Recebido (R$)" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextMainBrush}" Margin="0,0,0,4"/>
                            <TextBox x:Name="TxtRecebido" Text="0,00" TextChanged="TxtValores_TextChanged"/>
                        </StackPanel>
                    </Grid>

                    <!-- Totais -->
                    <Border Background="#1D1D1F" CornerRadius="14" Padding="14" Margin="0,4,0,12">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,6">
                                <TextBlock Text="Subtotal:" Foreground="#A1A1A6" FontSize="13"/>
                                <TextBlock x:Name="TxtSubtotal" Text="R$ 0,00" Foreground="White" FontSize="13" HorizontalAlignment="Right"/>
                            </DockPanel>
                            <DockPanel Margin="0,0,0,8">
                                <TextBlock Text="Troco:" Foreground="#A1A1A6" FontSize="13"/>
                                <TextBlock x:Name="TxtTroco" Text="R$ 0,00" Foreground="#CCCCCC" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                            </DockPanel>
                            <Separator Background="#38383A" Margin="0,2,0,8"/>
                            <DockPanel>
                                <TextBlock Text="TOTAL:" Foreground="White" FontSize="17" FontWeight="SemiBold"/>
                                <TextBlock x:Name="TxtTotal" Text="R$ 0,00" Foreground="#2997FF" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Padrão de Impressão" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextMainBrush}" Margin="0,0,0,4"/>
                    <ComboBox x:Name="CmbPadraoImpressao" Margin="0,0,0,8" SelectionChanged="CmbPadraoImpressao_SelectionChanged">
                        <ComboBoxItem Content="Cupom Não Fiscal (Bobina 80mm)" IsSelected="True"/>
                        <ComboBoxItem Content="Folha A4 (PDF / Impressora Comum)"/>
                    </ComboBox>

                    <StackPanel x:Name="PanelImpressoraTermica">
                        <TextBlock Text="Impressora Térmica / Padrão" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextMainBrush}" Margin="0,0,0,4"/>
                        <ComboBox x:Name="CmbImpressora" Margin="0,0,0,8"/>
                    </StackPanel>

                    <CheckBox x:Name="ChkImprimirCupom" Content="Imprimir comprovante automaticamente" IsChecked="True" Margin="0,0,0,14"/>

                    <Button Content="FINALIZAR VENDA" Style="{StaticResource SuccessButton}" Height="44" FontSize="14.5" Click="BtnFinalizar_Click" Margin="0,0,0,8"/>
                    <Button Content="Limpar Carrinho" Style="{StaticResource SecondaryButton}" Click="BtnLimparCarrinho_Click"/>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>

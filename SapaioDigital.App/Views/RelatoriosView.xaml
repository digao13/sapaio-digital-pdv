<UserControl x:Class="SapaioDigital.App.Views.RelatoriosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Filtros -->
        <Border Grid.Row="0" Background="{DynamicResource BgCardBrush}" CornerRadius="8" Padding="12" Margin="0,0,0,12" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
            <WrapPanel VerticalAlignment="Center">
                <TextBlock Text="Data Inicial:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,4,6,4"/>
                <DatePicker x:Name="DpInicio" Margin="0,2,14,2"/>
                <TextBlock Text="Data Final:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,4,6,4"/>
                <DatePicker x:Name="DpFim" Margin="0,2,14,2"/>
                <Button Content="Filtrar Relatórios" Style="{StaticResource PrimaryButton}" Click="BtnFiltrar_Click"/>
            </WrapPanel>
        </Border>

        <!-- Cards de Resumo -->
        <UniformGrid Grid.Row="1" Columns="3" Margin="0,0,0,12">
            <Border Background="{DynamicResource BgCardBrush}" CornerRadius="8" Padding="14" Margin="0,0,6,0" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="TOTAL EM VENDAS (PDV)" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap"/>
                    <TextBlock x:Name="TxtResumoVendas" Text="R$ 0,00" FontSize="19" FontWeight="Bold" Foreground="#16A34A" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
            <Border Background="{DynamicResource BgCardBrush}" CornerRadius="8" Padding="14" Margin="4,0" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="BAIXAS / SAÍDAS DE ESTOQUE" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap"/>
                    <TextBlock x:Name="TxtResumoBaixas" Text="0 itens" FontSize="19" FontWeight="Bold" Foreground="#DC2626" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
            <Border Background="{DynamicResource BgCardBrush}" CornerRadius="8" Padding="14" Margin="6,0,0,0" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="ORÇAMENTOS / OS NO PERÍODO" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap"/>
                    <TextBlock x:Name="TxtResumoOs" Text="0 OS" FontSize="19" FontWeight="Bold" Foreground="#2563EB" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- Abas -->
        <TabControl Grid.Row="2" Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource CardBorderBrush}">
            <TabItem Header="📦 Baixas e Movimentações de Estoque">
                <DataGrid x:Name="GridMovimentacoes" Margin="8" ScrollViewer.HorizontalScrollBarVisibility="Auto">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Data/Hora" Binding="{Binding DataHora, StringFormat=dd/MM/yyyy HH:mm}" Width="125"/>
                        <DataGridTextColumn Header="Tipo" Binding="{Binding Tipo}" Width="80"/>
                        <DataGridTextColumn Header="Produto" Binding="{Binding ProdutoNome}" Width="*" MinWidth="130"/>
                        <DataGridTextColumn Header="Qtd" Binding="{Binding Quantidade}" Width="60"/>
                        <DataGridTextColumn Header="Saldo Ant." Binding="{Binding SaldoAnterior}" Width="75"/>
                        <DataGridTextColumn Header="Saldo Novo" Binding="{Binding SaldoNovo}" Width="80"/>
                        <DataGridTextColumn Header="Usuário" Binding="{Binding UsuarioNome}" Width="110"/>
                        <DataGridTextColumn Header="Motivo" Binding="{Binding Motivo}" Width="160"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <TabItem Header="🛒 Vendas Realizadas (PDV)">
                <DockPanel Margin="8">
                    <Button DockPanel.Dock="Top" Content="🖨ï¸ Reimprimir Cupom da Venda Selecionada" Style="{StaticResource SecondaryButton}"
                            HorizontalAlignment="Right" Margin="0,0,0,8" Click="BtnReimprimirCupom_Click"/>
                    <DataGrid x:Name="GridVendas" ScrollViewer.HorizontalScrollBarVisibility="Auto">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Venda #" Binding="{Binding Id, StringFormat=D6}" Width="75"/>
                            <DataGridTextColumn Header="Data/Hora" Binding="{Binding DataHora, StringFormat=dd/MM/yyyy HH:mm}" Width="125"/>
                            <DataGridTextColumn Header="Cliente" Binding="{Binding ClienteNome}" Width="*" MinWidth="120"/>
                            <DataGridTextColumn Header="Operador" Binding="{Binding UsuarioNome}" Width="120"/>
                            <DataGridTextColumn Header="Pagamento" Binding="{Binding FormaPagamento}" Width="120"/>
                            <DataGridTextColumn Header="Total" Binding="{Binding Total, StringFormat=R$ {0:N2}}" Width="105"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <TabItem Header="🔧 Orçamentos / Ordens de Serviço Feitos">
                <DockPanel Margin="8">
                    <Button DockPanel.Dock="Top" Content="📄 Gerar / Reimprimir PDF da OS Selecionada" Style="{StaticResource SecondaryButton}"
                            HorizontalAlignment="Right" Margin="0,0,0,8" Click="BtnReimprimirOs_Click"/>
                    <DataGrid x:Name="GridOrcamentos" ScrollViewer.HorizontalScrollBarVisibility="Auto">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="OS #" Binding="{Binding Id, StringFormat=D5}" Width="65"/>
                            <DataGridTextColumn Header="Data/Hora" Binding="{Binding DataHora, StringFormat=dd/MM/yyyy HH:mm}" Width="125"/>
                            <DataGridTextColumn Header="Cliente" Binding="{Binding ClienteNome}" Width="*" MinWidth="120"/>
                            <DataGridTextColumn Header="Equipamento" Binding="{Binding Equipamento}" Width="130"/>
                            <DataGridTextColumn Header="Quem Fez" Binding="{Binding UsuarioNome}" Width="120"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="90"/>
                            <DataGridTextColumn Header="Valor" Binding="{Binding ValorEstimado, StringFormat=R$ {0:N2}}" Width="100"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>

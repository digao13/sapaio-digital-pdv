<UserControl x:Class="SapaioDigital.App.Views.UsuariosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="360"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="White" CornerRadius="8" Padding="16" Margin="0,0,16,0" BorderBrush="#E2E8F0" BorderThickness="1">
            <DataGrid x:Name="GridUsuarios" SelectionChanged="GridUsuarios_SelectionChanged">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50"/>
                    <DataGridTextColumn Header="Nome" Binding="{Binding Nome}" Width="*"/>
                    <DataGridTextColumn Header="Login" Binding="{Binding Login}" Width="140"/>
                    <DataGridTextColumn Header="Perfil" Binding="{Binding Perfil}" Width="120"/>
                    <DataGridCheckBoxColumn Header="Ativo" Binding="{Binding Ativo}" Width="65"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <Border Grid.Column="1" Background="White" CornerRadius="8" Padding="18" BorderBrush="#E2E8F0" BorderThickness="1" VerticalAlignment="Top">
            <StackPanel>
                <TextBlock x:Name="TxtTituloForm" Text="Novo Usuário" FontSize="16" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,12"/>

                <TextBlock Text="Nome Completo *" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4"/>
                <TextBox x:Name="TxtNome" Margin="0,0,0,10"/>

                <TextBlock Text="Login *" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4"/>
                <TextBox x:Name="TxtLogin" Margin="0,0,0,10"/>

                <TextBlock Text="Senha (deixe vazio ao editar para manter)" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4"/>
                <PasswordBox x:Name="TxtSenha" Margin="0,0,0,10"/>

                <TextBlock Text="Perfil" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4"/>
                <ComboBox x:Name="CmbPerfil" Margin="0,0,0,10">
                    <ComboBoxItem Content="Operador" IsSelected="True"/>
                    <ComboBoxItem Content="Administrador"/>
                </ComboBox>

                <CheckBox x:Name="ChkAtivo" Content="Usuário Ativo" IsChecked="True" Margin="0,4,0,16"/>

                <StackPanel Orientation="Horizontal">
                    <Button Content="Salvar Usuário" Style="{StaticResource PrimaryButton}" Click="BtnSalvar_Click" Margin="0,0,8,0"/>
                    <Button Content="Limpar / Novo" Style="{StaticResource SecondaryButton}" Click="BtnLimpar_Click"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>

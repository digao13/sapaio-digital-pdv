<UserControl x:Class="SapaioDigital.App.Views.ConfiguracoesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Foreground="{DynamicResource TextMainBrush}">
    <TabControl Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource CardBorderBrush}">
        <!-- ABA 1: DADOS DA LOJA -->
        <TabItem Header="Dados da Loja">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
                <Border MaxWidth="640" HorizontalAlignment="Left" Background="{DynamicResource BgCardBrush}" CornerRadius="18" Padding="24" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Informações da Loja (Orçamentos e PDV)" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource TextMainBrush}" Margin="0,0,0,16"/>

                        <TextBlock Text="Razão Social *" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4"/>
                        <TextBox x:Name="TxtRazaoSocial" Margin="0,0,0,12"/>

                        <TextBlock Text="Telefone / WhatsApp *" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4"/>
                        <TextBox x:Name="TxtTelefone" Margin="0,0,0,12"/>

                        <TextBlock Text="Foto / Logo da Loja *" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,6"/>
                        <WrapPanel Margin="0,0,0,18">
                            <Border Width="104" Height="80" BorderBrush="{DynamicResource BorderBrushLight}" BorderThickness="1" CornerRadius="12" Background="{DynamicResource BgSubtleBrush}" ClipToBounds="True" Margin="0,0,14,6">
                                <Image x:Name="ImgLogo" MaxWidth="94" MaxHeight="70" Stretch="Uniform"
                                       RenderOptions.BitmapScalingMode="HighQuality" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <Button Content="Alterar Foto / Logo..." Style="{StaticResource SecondaryButton}" VerticalAlignment="Center" Click="BtnSelecionarLogo_Click"/>
                        </WrapPanel>

                        <Button Content="Salvar Dados da Loja" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Click="BtnSalvarLoja_Click"/>
                    </StackPanel>
                </Border>
            </ScrollViewer>
        </TabItem>

        <!-- ABA 2: BACKUP LOCAL & NUVEM -->
        <TabItem Header="Backup Local &amp; Nuvem">
            <Grid Margin="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="0.46*" MinWidth="360"/>
                    <ColumnDefinition Width="0.54*" MinWidth="380"/>
                </Grid.ColumnDefinitions>

                <!-- Configuração e Provedores -->
                <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="0,0,14,0">
                    <StackPanel>
                        <Border Background="{DynamicResource BgSubtleBrush}" CornerRadius="18" Padding="20" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="1. Escolha onde salvar os Backups" FontSize="15.5" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                <TextBlock Text="Conecte automaticamente com a pasta sincronizada da sua nuvem (sem precisar de login OAuth/API) ou escolha uma pasta local."
                                           TextWrapping="Wrap" FontSize="12.5" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,12"/>

                                <TextBlock Text="Plataforma Ativa:" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}"/>
                                <TextBlock x:Name="TxtPlataformaAtiva" Text="Local" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryLinkBrush}" Margin="0,2,0,8"/>

                                <TextBlock Text="Pasta de Destino Atual:" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,4"/>
                                <TextBox x:Name="TxtPastaBackup" IsReadOnly="True" Margin="0,0,0,12"/>

                                <StackPanel Margin="0,0,0,10">
                                    <DockPanel Margin="0,0,0,6">
                                        <Button DockPanel.Dock="Right" Content="Usar OneDrive" Style="{StaticResource SecondaryButton}" Padding="12,6" Click="BtnOneDrive_Click"/>
                                        <TextBlock x:Name="TxtStatusOneDrive" Text="OneDrive: verificando..." VerticalAlignment="Center" FontSize="12" TextWrapping="Wrap" Margin="0,0,8,0"/>
                                    </DockPanel>
                                    <DockPanel Margin="0,0,0,6">
                                        <Button DockPanel.Dock="Right" Content="Usar Google Drive" Style="{StaticResource SecondaryButton}" Padding="12,6" Click="BtnGoogleDrive_Click"/>
                                        <TextBlock x:Name="TxtStatusGoogleDrive" Text="Google Drive: verificando..." VerticalAlignment="Center" FontSize="12" TextWrapping="Wrap" Margin="0,0,8,0"/>
                                    </DockPanel>
                                    <DockPanel Margin="0,0,0,8">
                                        <Button DockPanel.Dock="Right" Content="Usar Dropbox" Style="{StaticResource SecondaryButton}" Padding="12,6" Click="BtnDropbox_Click"/>
                                        <TextBlock x:Name="TxtStatusDropbox" Text="Dropbox: verificando..." VerticalAlignment="Center" FontSize="12" TextWrapping="Wrap" Margin="0,0,8,0"/>
                                    </DockPanel>
                                </StackPanel>

                                <Button Content="Escolher Pasta Local / Rede / Pendrive..." Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Click="BtnEscolherPasta_Click"/>
                            </StackPanel>
                        </Border>

                        <Border Background="{DynamicResource BgSubtleBrush}" CornerRadius="18" Padding="20" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="2. Rotina Automática" FontSize="15.5" FontWeight="SemiBold" Margin="0,0,0,10"/>
                                <CheckBox x:Name="ChkBackupDiario" Content="Fazer backup automático todo dia na primeira abertura" IsChecked="True"
                                          Checked="ChkBackupDiario_Changed" Unchecked="ChkBackupDiario_Changed" Margin="0,0,0,10"/>

                                <TextBlock x:Name="TxtUltimoBackup" Text="Último backup: ainda não realizado" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,0,0,14"/>

                                <WrapPanel>
                                    <Button Content="Fazer Backup Agora" Style="{StaticResource PrimaryButton}" Margin="0,0,8,6" Click="BtnBackup_Click"/>
                                    <Button Content="Abrir Pasta de Backups" Style="{StaticResource SecondaryButton}" Margin="0,0,0,6" Click="BtnAbrirPastaBackup_Click"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- Histórico e Restauração -->
                <Border Grid.Column="1" Background="{DynamicResource BgSubtleBrush}" CornerRadius="18" Padding="18" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="3. Histórico de Backups Disponíveis" FontSize="15.5" FontWeight="SemiBold"/>
                                <TextBlock Text="Selecione um arquivo abaixo caso precise restaurar o banco de dados." FontSize="12" Foreground="{DynamicResource TextMutedBrush}"/>
                            </StackPanel>
                            <Button DockPanel.Dock="Right" Content="Restaurar Selecionado" Style="{StaticResource DangerButton}" Padding="14,8" HorizontalAlignment="Right" VerticalAlignment="Center" Click="BtnRestaurarBackup_Click"/>
                        </DockPanel>

                        <DataGrid x:Name="GridBackups" ScrollViewer.HorizontalScrollBarVisibility="Auto">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Arquivo" Binding="{Binding NomeArquivo}" Width="*" MinWidth="180"/>
                                <DataGridTextColumn Header="Data/Hora" Binding="{Binding DataCriacao, StringFormat=dd/MM/yyyy HH:mm}" Width="125"/>
                                <DataGridTextColumn Header="Tamanho" Binding="{Binding TamanhoFormatado}" Width="85"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>
            </Grid>
        </TabItem>

        <!-- ABA 3: ATUALIZAÇÕES GITHUB -->
        <TabItem Header="Atualizações (GitHub)">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
                <Border MaxWidth="640" HorizontalAlignment="Left" Background="{DynamicResource BgCardBrush}" CornerRadius="18" Padding="24" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Atualização Automática via GitHub" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <TextBlock x:Name="TxtVersao" Text="Versão instalada: 1.1.0" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryLinkBrush}" Margin="0,0,0,4"/>
                        <TextBlock Text="Repositório: digao13/sapaio-digital-pdv" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,12"/>
                        <TextBlock x:Name="TxtStatusUpdate" Text="Verifique se há novas versões no GitHub para atualizar o sistema preservando seu banco de dados." TextWrapping="Wrap" Margin="0,0,0,16"/>

                        <WrapPanel>
                            <Button x:Name="BtnVerificar" Content="Verificar Atualizações" Style="{StaticResource PrimaryButton}" Click="BtnVerificar_Click" Margin="0,0,8,6"/>
                            <Button x:Name="BtnAplicar" Content="Baixar e Atualizar Agora" Style="{StaticResource SuccessButton}" Visibility="Collapsed" Click="BtnAplicar_Click" Margin="0,0,0,6"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>
            </ScrollViewer>
        </TabItem>
    </TabControl>
</UserControl>

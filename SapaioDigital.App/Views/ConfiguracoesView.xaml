<UserControl x:Class="SapaioDigital.App.Views.ConfiguracoesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Dados da Loja -->
        <Border Grid.Column="0" Background="White" CornerRadius="8" Padding="20" Margin="0,0,16,0" BorderBrush="#E2E8F0" BorderThickness="1" VerticalAlignment="Top">
            <StackPanel>
                <TextBlock Text="Dados da Loja (Orçamentos e PDV)" FontSize="16" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,14"/>

                <TextBlock Text="Razão Social *" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4"/>
                <TextBox x:Name="TxtRazaoSocial" Margin="0,0,0,10"/>

                <TextBlock Text="Telefone / WhatsApp *" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4"/>
                <TextBox x:Name="TxtTelefone" Margin="0,0,0,10"/>

                <TextBlock Text="Foto / Logo da Loja *" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                    <Border Width="88" Height="70" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Background="#F8FAFC" Margin="0,0,12,0">
                        <Image x:Name="ImgLogo" Stretch="Uniform" Margin="4"/>
                    </Border>
                    <Button Content="Alterar Foto / Logo..." Style="{StaticResource SecondaryButton}" VerticalAlignment="Center" Click="BtnSelecionarLogo_Click"/>
                </StackPanel>

                <Button Content="Salvar Dados da Loja" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Click="BtnSalvarLoja_Click"/>
            </StackPanel>
        </Border>

        <!-- Atualização GitHub & Segurança do Banco -->
        <StackPanel Grid.Column="1">
            <Border Background="White" CornerRadius="8" Padding="20" Margin="0,0,0,14" BorderBrush="#E2E8F0" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Atualização Automática via GitHub" FontSize="16" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,8"/>
                    <TextBlock x:Name="TxtVersao" Text="Versão instalada: 1.0.0" FontWeight="SemiBold" Foreground="#2563EB" Margin="0,0,0,6"/>
                    <TextBlock Text="Repositório: digao13/sapaio-digital-pdv" FontSize="12" Foreground="#64748B" Margin="0,0,0,10"/>
                    <TextBlock x:Name="TxtStatusUpdate" Text="Clique no botão abaixo para verificar se há novas versões no GitHub." TextWrapping="Wrap" Margin="0,0,0,14"/>

                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="BtnVerificar" Content="Verificar Atualizações" Style="{StaticResource PrimaryButton}" Click="BtnVerificar_Click" Margin="0,0,8,0"/>
                        <Button x:Name="BtnAplicar" Content="Baixar e Atualizar Agora" Style="{StaticResource SuccessButton}" Visibility="Collapsed" Click="BtnAplicar_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Background="White" CornerRadius="8" Padding="20" BorderBrush="#E2E8F0" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Segurança do Banco de Dados (SQLite)" FontSize="16" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,8"/>
                    <TextBlock Text="Seu banco de dados fica armazenado fora da pasta do aplicativo para nunca ser substituído durante atualizações:" TextWrapping="Wrap" Foreground="#475569" FontSize="12.5" Margin="0,0,0,6"/>
                    <TextBox x:Name="TxtCaminhoBanco" IsReadOnly="True" Background="#F8FAFC" FontSize="11.5" Margin="0,0,0,12"/>
                    <Button Content="Fazer Backup Agora" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Click="BtnBackup_Click"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>

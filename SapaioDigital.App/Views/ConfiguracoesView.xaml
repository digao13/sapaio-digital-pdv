<UserControl x:Class="SapaioDigital.App.Views.ConfiguracoesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Dados da Loja -->
        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="0,0,14,0">
            <Border Background="{DynamicResource BgCardBrush}" CornerRadius="8" Padding="20" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock Text="Dados da Loja (Orçamentos e PDV)" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextMainBrush}" TextWrapping="Wrap" Margin="0,0,0,14"/>

                    <TextBlock Text="Razão Social *" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4"/>
                    <TextBox x:Name="TxtRazaoSocial" Margin="0,0,0,10"/>

                    <TextBlock Text="Telefone / WhatsApp *" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4"/>
                    <TextBox x:Name="TxtTelefone" Margin="0,0,0,10"/>

                    <TextBlock Text="Foto / Logo da Loja *" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4"/>
                    <WrapPanel Margin="0,0,0,14">
                        <Border Width="96" Height="74" BorderBrush="{DynamicResource BorderBrushLight}" BorderThickness="1" CornerRadius="6" Background="{DynamicResource BgSubtleBrush}" ClipToBounds="True" Margin="0,0,12,6">
                            <Image x:Name="ImgLogo" MaxWidth="88" MaxHeight="66" Stretch="Uniform"
                                   RenderOptions.BitmapScalingMode="HighQuality" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <Button Content="Alterar Foto / Logo..." Style="{StaticResource SecondaryButton}" VerticalAlignment="Center" Click="BtnSelecionarLogo_Click"/>
                    </WrapPanel>

                    <Button Content="Salvar Dados da Loja" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Click="BtnSalvarLoja_Click"/>
                </StackPanel>
            </Border>
        </ScrollViewer>

        <!-- Atualização GitHub & Segurança do Banco -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Background="{DynamicResource BgCardBrush}" CornerRadius="8" Padding="20" Margin="0,0,0,14" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Atualização Automática via GitHub" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextMainBrush}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                        <TextBlock x:Name="TxtVersao" Text="Versão instalada: 1.0.1" FontWeight="SemiBold" Foreground="#2563EB" Margin="0,0,0,6"/>
                        <TextBlock Text="Repositório: digao13/sapaio-digital-pdv" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,10"/>
                        <TextBlock x:Name="TxtStatusUpdate" Text="Clique no botão abaixo para verificar se há novas versões (Instalador ou Pacote) no GitHub." TextWrapping="Wrap" Margin="0,0,0,14"/>

                        <WrapPanel>
                            <Button x:Name="BtnVerificar" Content="Verificar Atualizações" Style="{StaticResource PrimaryButton}" Click="BtnVerificar_Click" Margin="0,0,8,6"/>
                            <Button x:Name="BtnAplicar" Content="Baixar e Atualizar Agora" Style="{StaticResource SuccessButton}" Visibility="Collapsed" Click="BtnAplicar_Click" Margin="0,0,0,6"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <Border Background="{DynamicResource BgCardBrush}" CornerRadius="8" Padding="20" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Segurança do Banco de Dados (SQLite)" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextMainBrush}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                        <TextBlock Text="Seu banco de dados fica armazenado fora da pasta do aplicativo para nunca ser substituído durante atualizações ou reinstalações:" TextWrapping="Wrap" Foreground="{DynamicResource TextMutedBrush}" FontSize="12.5" Margin="0,0,0,6"/>
                        <TextBox x:Name="TxtCaminhoBanco" IsReadOnly="True" Background="{DynamicResource BgSubtleBrush}" FontSize="11.5" Margin="0,0,0,12"/>
                        <Button Content="Fazer Backup Agora" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Click="BtnBackup_Click"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>

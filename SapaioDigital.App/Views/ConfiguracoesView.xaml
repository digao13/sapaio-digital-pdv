<UserControl x:Class="SapaioDigital.App.Views.ConfiguracoesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Foreground="{DynamicResource TextMainBrush}">
    <TabControl Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource CardBorderBrush}">
        <!-- ABA 1: DADOS DA LOJA -->
        <TabItem Header="Dados da Loja">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
                <Border MaxWidth="640" HorizontalAlignment="Left" Background="{DynamicResource BgCardBrush}" CornerRadius="18" Padding="24" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Informações da Loja (Orçamentos e PDV)" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource TextMainBrush}" Margin="0,0,0,16"/>

                        <TextBlock Text="Razão Social *" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4"/>
                        <TextBox x:Name="TxtRazaoSocial" Margin="0,0,0,12"/>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Telefone / WhatsApp *" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4"/>
                                <TextBox x:Name="TxtTelefone"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="CNPJ (opcional)" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4"/>
                                <TextBox x:Name="TxtCnpj"/>
                            </StackPanel>
                        </Grid>

                        <Border Background="{DynamicResource BgSubtleBrush}" CornerRadius="12" Padding="12" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Endereço da Loja (CEP automático)" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,6"/>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="TxtLojaCep" Grid.Column="0" MaxLength="9" ToolTip="Digite os 8 dígitos do CEP" TextChanged="TxtLojaCep_TextChanged"/>
                                    <Button x:Name="BtnBuscarCepLoja" Grid.Column="2" Content="Buscar CEP" Style="{StaticResource SecondaryButton}" Padding="10,6" Click="BtnBuscarCepLoja_Click"/>
                                </Grid>

                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="92"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Rua / Logradouro" FontWeight="SemiBold" FontSize="11.5" Margin="0,0,0,3"/>
                                        <TextBox x:Name="TxtLojaRua" TextChanged="CampoEnderecoLoja_TextChanged"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Número" FontWeight="SemiBold" FontSize="11.5" Margin="0,0,0,3"/>
                                        <TextBox x:Name="TxtLojaNumero" TextChanged="CampoEnderecoLoja_TextChanged"/>
                                    </StackPanel>
                                </Grid>

                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="68"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Cidade" FontWeight="SemiBold" FontSize="11.5" Margin="0,0,0,3"/>
                                        <TextBox x:Name="TxtLojaCidade" TextChanged="CampoEnderecoLoja_TextChanged"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="UF" FontWeight="SemiBold" FontSize="11.5" Margin="0,0,0,3"/>
                                        <TextBox x:Name="TxtLojaUf" MaxLength="2" TextAlignment="Center" TextChanged="CampoEnderecoLoja_TextChanged"/>
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="Endereço Completo" FontWeight="SemiBold" FontSize="11.5" Margin="0,0,0,3"/>
                                <TextBox x:Name="TxtLojaEndereco" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Foto / Logo da Loja *" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,6"/>
                        <WrapPanel Margin="0,0,0,18">
                            <Border Width="104" Height="80" BorderBrush="{DynamicResource BorderBrushLight}" BorderThickness="1" CornerRadius="12" Background="{DynamicResource BgSubtleBrush}" ClipToBounds="True" Margin="0,0,14,6">
                                <Image x:Name="ImgLogo" MaxWidth="94" MaxHeight="70" Stretch="Uniform"
                                       RenderOptions.BitmapScalingMode="HighQuality" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <Button Content="Alterar Foto / Logo..." Style="{StaticResource SecondaryButton}" VerticalAlignment="Center" Click="BtnSelecionarLogo_Click"/>
                        </WrapPanel>

                        <Button Content="Salvar Dados da Loja" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Click="BtnSalvarLoja_Click"/>
                    </StackPanel>
                </Border>
            </ScrollViewer>
        </TabItem>

        <!-- ABA 2: BACKUP NUVEM & LOCAL -->
        <TabItem Header="Backup Nuvem &amp; Local">
            <Grid Margin="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="0.54*" MinWidth="420"/>
                    <ColumnDefinition Width="0.46*" MinWidth="340"/>
                </Grid.ColumnDefinitions>

                <!-- Coluna Esquerda: 3 Servidores de Nuvem Independentes + Backup Local -->
                <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="0,0,14,0">
                    <StackPanel>
                        <!-- 1. DROPBOX -->
                        <Border Background="{DynamicResource BgSubtleBrush}" CornerRadius="18" Padding="18" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Margin="0,0,0,12">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,6">
                                    <TextBlock Text="Dropbox (Envio Direto para Nuvem)" FontSize="15" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="TxtStatusDropbox" DockPanel.Dock="Right" Text="Desconectado" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </DockPanel>
                                <TextBlock Text="Como configurar: 1) Clique em 'Abrir Portal Dropbox' -> Scoped access -> App folder -> Create app. 2) Em Permissions marque files.content.write e files.content.read -> Submit. 3) Em Settings -> Redirect URIs cole http://127.0.0.1:54821/callback. 4) Copie o 'App key' abaixo:"
                                           TextWrapping="Wrap" FontSize="11.5" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,8"/>

                                <TextBlock Text="App Key (Client ID)" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                <TextBox x:Name="TxtDropboxId" Margin="0,0,0,10"/>

                                <WrapPanel>
                                    <Button x:Name="BtnConectarDropbox" Content="Conectar Dropbox" Style="{StaticResource PrimaryButton}" Padding="14,7" Margin="0,0,8,4" Click="BtnConectarDropbox_Click"/>
                                    <Button x:Name="BtnDesconectarDropbox" Content="Desconectar" Style="{StaticResource SecondaryButton}" Padding="12,7" Visibility="Collapsed" Margin="0,0,8,4" Click="BtnDesconectarDropbox_Click"/>
                                    <Button Content="Abrir Portal Dropbox" Style="{StaticResource SecondaryButton}" Padding="12,7" Margin="0,0,0,4" Click="BtnPortalDropbox_Click"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <!-- 2. ONEDRIVE -->
                        <Border Background="{DynamicResource BgSubtleBrush}" CornerRadius="18" Padding="18" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Margin="0,0,0,12">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,6">
                                    <TextBlock Text="OneDrive (Microsoft)" FontSize="15" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="TxtStatusOneDrive" DockPanel.Dock="Right" Text="Desconectado" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </DockPanel>
                                <TextBlock Text="Como configurar: 1) Clique em 'Abrir Portal Azure' -> Novo registro -> escolha 'Contas pessoais da Microsoft'. 2) Em Autenticação -> Adicionar plataforma -> 'Aplicativos móveis e de área de trabalho' -> cole http://127.0.0.1:54821/callback. 3) Copie o 'ID do aplicativo (cliente)' abaixo:"
                                           TextWrapping="Wrap" FontSize="11.5" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,8"/>

                                <TextBlock Text="ID do Aplicativo (Client ID)" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                <TextBox x:Name="TxtOneDriveId" Margin="0,0,0,10"/>

                                <WrapPanel>
                                    <Button x:Name="BtnConectarOneDrive" Content="Conectar OneDrive" Style="{StaticResource PrimaryButton}" Padding="14,7" Margin="0,0,8,4" Click="BtnConectarOneDrive_Click"/>
                                    <Button x:Name="BtnDesconectarOneDrive" Content="Desconectar" Style="{StaticResource SecondaryButton}" Padding="12,7" Visibility="Collapsed" Margin="0,0,8,4" Click="BtnDesconectarOneDrive_Click"/>
                                    <Button Content="Abrir Portal Azure" Style="{StaticResource SecondaryButton}" Padding="12,7" Margin="0,0,0,4" Click="BtnPortalOneDrive_Click"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <!-- 3. GOOGLE DRIVE -->
                        <Border Background="{DynamicResource BgSubtleBrush}" CornerRadius="18" Padding="18" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Margin="0,0,0,12">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,6">
                                    <TextBlock Text="Google Drive" FontSize="15" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="TxtStatusGoogleDrive" DockPanel.Dock="Right" Text="Desconectado" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </DockPanel>
                                <TextBlock Text="Como configurar: 1) No Google Cloud Console, ative a 'Google Drive API'. 2) Em Tela de permissão OAuth (Externo), adicione seu e-mail em 'Usuários de teste'. 3) Em Credenciais -> Criar ID do cliente OAuth -> 'Aplicativo para computador (Desktop)'. 4) Cole Client ID e Client Secret:"
                                           TextWrapping="Wrap" FontSize="11.5" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,8"/>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Client ID" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                        <TextBox x:Name="TxtGoogleId"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Client Secret" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                        <TextBox x:Name="TxtGoogleSecret"/>
                                    </StackPanel>
                                </Grid>

                                <WrapPanel>
                                    <Button x:Name="BtnConectarGoogle" Content="Conectar Google Drive" Style="{StaticResource PrimaryButton}" Padding="14,7" Margin="0,0,8,4" Click="BtnConectarGoogle_Click"/>
                                    <Button x:Name="BtnDesconectarGoogle" Content="Desconectar" Style="{StaticResource SecondaryButton}" Padding="12,7" Visibility="Collapsed" Margin="0,0,8,4" Click="BtnDesconectarGoogle_Click"/>
                                    <Button Content="Abrir Google Cloud" Style="{StaticResource SecondaryButton}" Padding="12,7" Margin="0,0,0,4" Click="BtnPortalGoogle_Click"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <!-- 4. BACKUP LOCAL + ROTINA -->
                        <Border Background="{DynamicResource BgSubtleBrush}" CornerRadius="18" Padding="18" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="Backup Local (Pasta no Computador / Pendrive / Rede)" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                <TextBox x:Name="TxtPastaBackup" IsReadOnly="True" Margin="0,0,0,10"/>

                                <WrapPanel Margin="0,0,0,10">
                                    <Button Content="Escolher Pasta Local..." Style="{StaticResource SecondaryButton}" Padding="12,7" Margin="0,0,8,4" Click="BtnEscolherPasta_Click"/>
                                    <Button Content="Abrir Pasta Local" Style="{StaticResource SecondaryButton}" Padding="12,7" Margin="0,0,0,4" Click="BtnAbrirPastaBackup_Click"/>
                                </WrapPanel>

                                <CheckBox x:Name="ChkBackupDiario" Content="Fazer backup automático todo dia na primeira abertura (Local + Nuvens conectadas)" IsChecked="True"
                                          Checked="ChkBackupDiario_Changed" Unchecked="ChkBackupDiario_Changed" Margin="0,0,0,8"/>

                                <TextBlock x:Name="TxtUltimoBackup" Text="Último backup: ainda não realizado" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,0,0,12"/>

                                <Button Content="Fazer Backup Agora (Local + Nuvens)" Style="{StaticResource SuccessButton}" HorizontalAlignment="Left" Click="BtnBackup_Click"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- Coluna Direita: Histórico e Restauração -->
                <Border Grid.Column="1" Background="{DynamicResource BgSubtleBrush}" CornerRadius="18" Padding="18" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Histórico de Backups Locais" FontSize="15.5" FontWeight="SemiBold"/>
                                <TextBlock Text="Selecione um arquivo para restaurar o banco de dados." FontSize="12" Foreground="{DynamicResource TextMutedBrush}"/>
                            </StackPanel>
                            <Button DockPanel.Dock="Right" Content="Restaurar Selecionado" Style="{StaticResource DangerButton}" Padding="14,8" HorizontalAlignment="Right" VerticalAlignment="Center" Click="BtnRestaurarBackup_Click"/>
                        </DockPanel>

                        <DataGrid x:Name="GridBackups" ScrollViewer.HorizontalScrollBarVisibility="Auto">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Arquivo" Binding="{Binding NomeArquivo}" Width="*" MinWidth="160"/>
                                <DataGridTextColumn Header="Data/Hora" Binding="{Binding DataCriacao, StringFormat=dd/MM/yyyy HH:mm}" Width="120"/>
                                <DataGridTextColumn Header="Tamanho" Binding="{Binding TamanhoFormatado}" Width="80"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>
            </Grid>
        </TabItem>

        <!-- ABA 3: ATUALIZAÇÕES GITHUB -->
        <TabItem Header="Atualizações">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
                <Border MaxWidth="640" HorizontalAlignment="Left" Background="{DynamicResource BgCardBrush}" CornerRadius="18" Padding="24" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Atualização do Sistema" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <TextBlock x:Name="TxtVersao" Text="Versão instalada: 1.4.0" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryLinkBrush}" Margin="0,0,0,4"/>
                        <TextBlock Text="Repositório: digao13/sapaio-digital-pdv" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,12"/>
                        <TextBlock x:Name="TxtStatusUpdate" Text="Verifique se há novas versões no GitHub para atualizar o sistema preservando seu banco de dados." TextWrapping="Wrap" Margin="0,0,0,16"/>

                        <WrapPanel>
                            <Button x:Name="BtnVerificar" Content="Verificar Atualizações" Style="{StaticResource PrimaryButton}" Click="BtnVerificar_Click" Margin="0,0,8,6"/>
                            <Button x:Name="BtnAplicar" Content="Baixar e Atualizar Agora" Style="{StaticResource SuccessButton}" Visibility="Collapsed" Click="BtnAplicar_Click" Margin="0,0,0,6"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>
            </ScrollViewer>
        </TabItem>

        <!-- ABA 4: TELA & RESOLUÇÃO -->
        <TabItem Header="Tela &amp; Resolução">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
                <Border MaxWidth="640" HorizontalAlignment="Left" Background="{DynamicResource BgCardBrush}" CornerRadius="18" Padding="24" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Ajuste de Resolução e Escala da Tela" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource TextMainBrush}" Margin="0,0,0,6"/>
                        <TextBlock Text="Escolha como o sistema deve se adaptar ao tamanho do seu monitor. No modo Automático, a escala e os limites são ajustados sozinhos para telas menores ou maiores." TextWrapping="Wrap" FontSize="12.5" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,14"/>

                        <TextBlock x:Name="TxtResolucaoAtual" Text="Área útil detectada: -" FontWeight="SemiBold" FontSize="12.5" Foreground="{DynamicResource PrimaryLinkBrush}" Margin="0,0,0,14"/>

                        <TextBlock Text="Resolução / Tamanho da Janela" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,5"/>
                        <ComboBox x:Name="CmbModoResolucao" MinHeight="36" Margin="0,0,0,12">
                            <ComboBoxItem Content="Automático (Ajustar à Tela — Recomendado)" Tag="Auto"/>
                            <ComboBoxItem Content="Compacta (1280 × 720)" Tag="1280x720"/>
                            <ComboBoxItem Content="Notebook Padrão (1366 × 768)" Tag="1366x768"/>
                            <ComboBoxItem Content="HD+ (1600 × 900)" Tag="1600x900"/>
                            <ComboBoxItem Content="Full HD (1920 × 1080)" Tag="1920x1080"/>
                            <ComboBoxItem Content="Sempre Maximizado (Tela Cheia)" Tag="Maximizado"/>
                        </ComboBox>

                        <TextBlock Text="Escala / Zoom da Interface (Letras e Campos)" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,5"/>
                        <ComboBox x:Name="CmbEscalaUi" MinHeight="36" Margin="0,0,0,18">
                            <ComboBoxItem Content="Automática (Ideal para a tela atual)" Tag="0"/>
                            <ComboBoxItem Content="85% — Mais espaço em telas pequenas" Tag="0.85"/>
                            <ComboBoxItem Content="90% — Compacto" Tag="0.90"/>
                            <ComboBoxItem Content="95% — Levemente reduzido" Tag="0.95"/>
                            <ComboBoxItem Content="100% — Tamanho padrão" Tag="1.00"/>
                            <ComboBoxItem Content="110% — Letras e botões maiores" Tag="1.10"/>
                            <ComboBoxItem Content="115% — Máxima visibilidade" Tag="1.15"/>
                        </ComboBox>

                        <WrapPanel>
                            <Button Content="Aplicar e Salvar" Style="{StaticResource PrimaryButton}" Click="BtnAplicarTela_Click" Margin="0,0,8,6"/>
                            <Button Content="Restaurar Automático" Style="{StaticResource SecondaryButton}" Click="BtnRestaurarTela_Click" Margin="0,0,0,6"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>
            </ScrollViewer>
        </TabItem>
        <!-- ABA 5: IMPRESSORA -->
        <TabItem Header="Impressora">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
                <Border MaxWidth="640" HorizontalAlignment="Left" Background="{DynamicResource BgCardBrush}" CornerRadius="18" Padding="24" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Parâmetros Padrão de Impressora" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource TextMainBrush}" Margin="0,0,0,6"/>
                        <TextBlock Text="Defina a impressora padrão de cupons, formato do papel e comportamento automático ao finalizar vendas no PDV." TextWrapping="Wrap" FontSize="12.5" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,16"/>

                        <TextBlock Text="Impressora Padrão de Cupom" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,5"/>
                        <ComboBox x:Name="CmbImpressoraPadrao" MinHeight="36" Margin="0,0,0,12"/>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Formato / Largura do Cupom" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,5"/>
                                <ComboBox x:Name="CmbFormatoCupom" MinHeight="36">
                                    <ComboBoxItem Content="Térmica 80mm (Padrão)" Tag="80mm"/>
                                    <ComboBoxItem Content="Térmica 58mm (Compacta)" Tag="58mm"/>
                                    <ComboBoxItem Content="Recibo A4 (PDF)" Tag="A4"/>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Cópias / Vias Padrão" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,5"/>
                                <ComboBox x:Name="CmbCopiasPadrao" MinHeight="36">
                                    <ComboBoxItem Content="1 via" Tag="1"/>
                                    <ComboBoxItem Content="2 vias" Tag="2"/>
                                </ComboBox>
                            </StackPanel>
                        </Grid>

                        <CheckBox x:Name="ChkAutoImprimirCupom" Content="Marcar 'Imprimir cupom' automaticamente no PDV ao abrir a tela" FontWeight="SemiBold" FontSize="12.5" Margin="0,4,0,18"/>

                        <Button Content="Salvar Parâmetros de Impressora" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Click="BtnSalvarImpressora_Click"/>
                    </StackPanel>
                </Border>
            </ScrollViewer>
        </TabItem>
    </TabControl>
</UserControl>

<UserControl x:Class="SapaioDigital.App.Views.ConfiguracoesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Foreground="{DynamicResource TextMainBrush}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Coluna 0: Dados da Loja -->
        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="0,0,14,0">
            <Border Background="{DynamicResource BgCardBrush}" CornerRadius="18" Padding="22" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock Text="Dados da Loja (Orçamentos e PDV)" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextMainBrush}" TextWrapping="Wrap" Margin="0,0,0,14"/>

                    <TextBlock Text="Razão Social *" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextMainBrush}" Margin="0,0,0,4"/>
                    <TextBox x:Name="TxtRazaoSocial" Margin="0,0,0,10"/>

                    <TextBlock Text="Telefone / WhatsApp *" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextMainBrush}" Margin="0,0,0,4"/>
                    <TextBox x:Name="TxtTelefone" Margin="0,0,0,10"/>

                    <TextBlock Text="Foto / Logo da Loja *" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextMainBrush}" Margin="0,0,0,4"/>
                    <WrapPanel Margin="0,0,0,16">
                        <Border Width="96" Height="74" BorderBrush="{DynamicResource BorderBrushLight}" BorderThickness="1" CornerRadius="10" Background="{DynamicResource BgSubtleBrush}" ClipToBounds="True" Margin="0,0,12,6">
                            <Image x:Name="ImgLogo" MaxWidth="88" MaxHeight="66" Stretch="Uniform"
                                   RenderOptions.BitmapScalingMode="HighQuality" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <Button Content="Alterar Foto / Logo..." Style="{StaticResource SecondaryButton}" VerticalAlignment="Center" Click="BtnSelecionarLogo_Click"/>
                    </WrapPanel>

                    <Button Content="Salvar Dados da Loja" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Click="BtnSalvarLoja_Click"/>
                </StackPanel>
            </Border>
        </ScrollViewer>

        <!-- Coluna 1: Atualização GitHub & Backup Local/Nuvem -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Background="{DynamicResource BgCardBrush}" CornerRadius="18" Padding="22" Margin="0,0,0,14" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Atualização Automática via GitHub" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextMainBrush}" TextWrapping="Wrap" Margin="0,0,0,6"/>
                        <TextBlock x:Name="TxtVersao" Text="Versão instalada: 1.0.5" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryLinkBrush}" Margin="0,0,0,4"/>
                        <TextBlock Text="Repositório: digao13/sapaio-digital-pdv" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,10"/>
                        <TextBlock x:Name="TxtStatusUpdate" Text="Verifique se há novas versões no GitHub para atualizar sem perder seu banco de dados." Foreground="{DynamicResource TextMainBrush}" TextWrapping="Wrap" Margin="0,0,0,14"/>

                        <WrapPanel>
                            <Button x:Name="BtnVerificar" Content="Verificar Atualizações" Style="{StaticResource PrimaryButton}" Click="BtnVerificar_Click" Margin="0,0,8,6"/>
                            <Button x:Name="BtnAplicar" Content="Baixar e Atualizar Agora" Style="{StaticResource SuccessButton}" Visibility="Collapsed" Click="BtnAplicar_Click" Margin="0,0,0,6"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <Border Background="{DynamicResource BgCardBrush}" CornerRadius="18" Padding="22" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Backup em Nuvem &amp; Local (SQLite)" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextMainBrush}" TextWrapping="Wrap" Margin="0,0,0,6"/>
                        <TextBlock Text="Escolha uma pasta local ou a pasta sincronizada do OneDrive, Dropbox ou Google Drive (sem precisar de login OAuth/API)."
                                   TextWrapping="Wrap" Foreground="{DynamicResource TextMutedBrush}" FontSize="12.5" Margin="0,0,0,10"/>

                        <TextBlock Text="Destino dos Backups" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextMainBrush}" Margin="0,0,0,4"/>
                        <TextBox x:Name="TxtPastaBackup" IsReadOnly="True" Margin="0,0,0,10"/>

                        <WrapPanel Margin="0,0,0,12">
                            <Button Content="OneDrive" Style="{StaticResource SecondaryButton}" Margin="0,0,6,6" Click="BtnOneDrive_Click"/>
                            <Button Content="Dropbox" Style="{StaticResource SecondaryButton}" Margin="0,0,6,6" Click="BtnDropbox_Click"/>
                            <Button Content="Google Drive" Style="{StaticResource SecondaryButton}" Margin="0,0,6,6" Click="BtnGoogleDrive_Click"/>
                            <Button Content="Escolher Pasta Local..." Style="{StaticResource SecondaryButton}" Margin="0,0,0,6" Click="BtnEscolherPasta_Click"/>
                        </WrapPanel>

                        <CheckBox x:Name="ChkBackupDiario" Content="Fazer backup automático todo dia na primeira abertura do sistema" IsChecked="True"
                                  Checked="ChkBackupDiario_Changed" Unchecked="ChkBackupDiario_Changed" Margin="0,0,0,8"/>

                        <TextBlock x:Name="TxtUltimoBackup" Text="Último backup: ainda não realizado" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,0,0,12"/>

                        <Button Content="Fazer Backup Agora" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Click="BtnBackup_Click"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>

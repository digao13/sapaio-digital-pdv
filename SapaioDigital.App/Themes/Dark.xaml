<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Tokens oficiais do DESIGN.md (Apple Dark Tiles) -->
    <SolidColorBrush x:Key="BgMainBrush" Color="#000000"/>
    <SolidColorBrush x:Key="BgCardBrush" Color="#1D1D1F"/>
    <SolidColorBrush x:Key="BgSubtleBrush" Color="#272729"/>
    <SolidColorBrush x:Key="BgInputBrush" Color="#252527"/>
    <SolidColorBrush x:Key="BgSidebarBrush" Color="#0A0A0C"/>
    <SolidColorBrush x:Key="BgSidebarCardBrush" Color="#1D1D1F"/>

    <SolidColorBrush x:Key="PrimaryBrush" Color="#0066CC"/>
    <SolidColorBrush x:Key="PrimaryHoverBrush" Color="#2997FF"/>
    <SolidColorBrush x:Key="PrimaryLinkBrush" Color="#2997FF"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="#2ECC71"/>
    <SolidColorBrush x:Key="DangerBrush" Color="#E74C3C"/>
    <SolidColorBrush x:Key="WarningBrush" Color="#F39C12"/>

    <SolidColorBrush x:Key="SecondaryBgBrush" Color="#2A2A2C"/>
    <SolidColorBrush x:Key="SecondaryHoverBrush" Color="#3A3A3C"/>
    <SolidColorBrush x:Key="SecondaryFgBrush" Color="#FFFFFF"/>

    <SolidColorBrush x:Key="TextMainBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="TextMutedBrush" Color="#A1A1A6"/>
    <SolidColorBrush x:Key="BorderBrushLight" Color="#3A3A3C"/>
    <SolidColorBrush x:Key="CardBorderBrush" Color="#2C2C2E"/>

    <SolidColorBrush x:Key="DataGridLineBrush" Color="#2C2C2E"/>
    <SolidColorBrush x:Key="DataGridBgBrush" Color="#1D1D1F"/>
    <SolidColorBrush x:Key="DataGridHeaderBgBrush" Color="#252527"/>
    <SolidColorBrush x:Key="DataGridRowHoverBrush" Color="#2A2A2C"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#252527"/>
</ResourceDictionary>

<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Tokens oficiais do DESIGN.md (Apple Light) -->
    <SolidColorBrush x:Key="BgMainBrush" Color="#F5F5F7"/>
    <SolidColorBrush x:Key="BgCardBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="BgSubtleBrush" Color="#FAFAFC"/>
    <SolidColorBrush x:Key="BgInputBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="BgSidebarBrush" Color="#111113"/>
    <SolidColorBrush x:Key="BgSidebarCardBrush" Color="#1D1D1F"/>

    <SolidColorBrush x:Key="PrimaryBrush" Color="#0066CC"/>
    <SolidColorBrush x:Key="PrimaryHoverBrush" Color="#0071E3"/>
    <SolidColorBrush x:Key="PrimaryLinkBrush" Color="#0066CC"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="#1D8348"/>
    <SolidColorBrush x:Key="DangerBrush" Color="#C0392B"/>
    <SolidColorBrush x:Key="WarningBrush" Color="#B9770E"/>

    <SolidColorBrush x:Key="SecondaryBgBrush" Color="#FAFAFC"/>
    <SolidColorBrush x:Key="SecondaryHoverBrush" Color="#F0F0F0"/>
    <SolidColorBrush x:Key="SecondaryFgBrush" Color="#1D1D1F"/>

    <SolidColorBrush x:Key="TextMainBrush" Color="#1D1D1F"/>
    <SolidColorBrush x:Key="TextMutedBrush" Color="#6E6E73"/>
    <SolidColorBrush x:Key="BorderBrushLight" Color="#D2D2D7"/>
    <SolidColorBrush x:Key="CardBorderBrush" Color="#E0E0E0"/>

    <SolidColorBrush x:Key="DataGridLineBrush" Color="#F0F0F0"/>
    <SolidColorBrush x:Key="DataGridBgBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="DataGridHeaderBgBrush" Color="#FAFAFC"/>
    <SolidColorBrush x:Key="DataGridRowHoverBrush" Color="#F5F5F7"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="#1D1D1F"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#FFFFFF"/>
</ResourceDictionary>

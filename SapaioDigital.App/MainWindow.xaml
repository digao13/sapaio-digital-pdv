<Window x:Class="SapaioDigital.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sampaio Digital — Sistema de Vendas e OS"
        Height="760" Width="1280" MinHeight="540" MinWidth="820"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        FontFamily="Segoe UI Variable, Segoe UI, Arial"
        Background="{DynamicResource BgMainBrush}"
        Foreground="{DynamicResource TextMainBrush}">
    <Grid x:Name="RootGrid">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="ColSidebar" Width="252"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar Estilo Apple Global Nav Dark com Ícones Segoe MDL2 Assets -->
        <Border Grid.Column="0" Background="{DynamicResource BgSidebarBrush}">
            <DockPanel>
                <!-- Cabeçalho da Loja na Sidebar -->
                <StackPanel x:Name="PanelSidebarHeader" DockPanel.Dock="Top" Margin="16,20,16,18">
                    <Border Background="{DynamicResource BgSidebarCardBrush}" CornerRadius="14" Padding="10" Margin="0,0,0,12" ClipToBounds="True" MinHeight="72">
                        <Image x:Name="ImgSidebarLogo" MaxHeight="60" MaxWidth="190" Stretch="Uniform"
                               RenderOptions.BitmapScalingMode="HighQuality" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock x:Name="TxtSidebarLoja" Text="Sampaio Digital" Foreground="White" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" TextAlignment="Center"/>
                    <TextBlock x:Name="TxtSidebarTelefone" Text="" Foreground="#A1A1A6" FontSize="12" TextWrapping="Wrap" TextAlignment="Center" Margin="0,3,0,0"/>
                </StackPanel>

                <!-- Rodapé com Usuário Conectado -->
                <Border x:Name="PanelSidebarFooter" DockPanel.Dock="Bottom" Background="{DynamicResource BgSidebarCardBrush}" Padding="14,14" Margin="12,0,12,16" CornerRadius="14">
                    <StackPanel>
                        <TextBlock Text="OPERADOR CONECTADO" FontSize="10" Foreground="#A1A1A6" FontWeight="SemiBold"/>
                        <TextBlock x:Name="TxtUsuarioConectado" Text="Admin" Foreground="White" FontSize="13.5" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,3,0,0"/>
                        <TextBlock x:Name="TxtVersaoApp" Text="Versão 1.4.0" Foreground="#8E8E93" FontSize="11.5" Margin="0,4,0,10"/>
                        <Button Content="Trocar Usuário" Style="{StaticResource SecondaryButton}" Padding="10,7" FontSize="12" Click="BtnTrocarUsuario_Click"/>
                    </StackPanel>
                </Border>

                <!-- Menu de Navegação com Ícones Vetoriais -->
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Button x:Name="BtnNavPdv" ToolTip="PDV (Vendas)" Style="{StaticResource SidebarButton}" Click="NavPdv_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE7BF;" FontSize="15" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <TextBlock x:Name="LblNavPdv" Text="PDV — Ponto de Venda" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="BtnNavOrc" ToolTip="Orçamentos / Ordem de Serviço" Style="{StaticResource SidebarButton}" Click="NavOrcamentos_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE90F;" FontSize="15" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <TextBlock x:Name="LblNavOrc" Text="Orçamentos e OS" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="BtnNavProd" ToolTip="Produtos e Estoque" Style="{StaticResource SidebarButton}" Click="NavProdutos_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE7B8;" FontSize="15" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <TextBlock x:Name="LblNavProd" Text="Produtos e Estoque" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="BtnNavCli" ToolTip="Clientes" Style="{StaticResource SidebarButton}" Click="NavClientes_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE716;" FontSize="15" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <TextBlock x:Name="LblNavCli" Text="Clientes" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="BtnNavRel" ToolTip="Relatórios e Dashboard" Style="{StaticResource SidebarButton}" Click="NavRelatorios_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE9D2;" FontSize="15" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <TextBlock x:Name="LblNavRel" Text="Relatórios &amp; Dashboard" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Separator Background="#272729" Margin="16,12"/>
                        <Button x:Name="BtnNavUsu" ToolTip="Usuários" Style="{StaticResource SidebarButton}" Click="NavUsuarios_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE77B;" FontSize="15" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <TextBlock x:Name="LblNavUsu" Text="Usuários" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="BtnNavCfg" ToolTip="Dados da Loja e Backup" Style="{StaticResource SidebarButton}" Click="NavConfiguracoes_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE713;" FontSize="15" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <TextBlock x:Name="LblNavCfg" Text="Loja &amp; Backup" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="BtnNavUpd" ToolTip="Atualizações do GitHub" Style="{StaticResource SidebarButton}" Click="NavConfiguracoes_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE895;" FontSize="15" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <TextBlock x:Name="LblNavUpd" Text="Atualizações (GitHub)" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- Conteúdo Principal -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="64"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,0,0,1" Padding="20,0,24,0">
                <DockPanel VerticalAlignment="Center">
                    <Button x:Name="BtnToggleSidebar" Content="☰" Style="{StaticResource SecondaryButton}" Padding="11,7" Margin="0,0,14,0"
                            ToolTip="Recolher/Expandir menu lateral" Click="BtnToggleSidebar_Click"/>
                    <TextBlock x:Name="TxtTituloPagina" Text="PDV — Ponto de Venda" FontSize="19" FontWeight="SemiBold" Foreground="{DynamicResource TextMainBrush}"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>

                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button x:Name="BtnUpdateDisponivel" Content="Atualizar Sistema" Style="{StaticResource PrimaryButton}"
                                Padding="14,7" FontSize="12.5" Margin="0,0,10,0" Visibility="Collapsed" Click="BtnUpdateDisponivel_Click"/>
                        <Button x:Name="BtnToggleTema" Content="Tema Escuro" Style="{StaticResource SecondaryButton}" Padding="14,7" FontSize="12.5" Margin="0,0,16,0"
                                Click="BtnToggleTema_Click"/>
                        <TextBlock x:Name="TxtDataHoraTopo" VerticalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}" FontSize="12.5"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <ContentControl x:Name="MainContent" Grid.Row="1" Margin="20"/>
        </Grid>
    </Grid>
</Window>

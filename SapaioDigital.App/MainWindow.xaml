<Window x:Class="SapaioDigital.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sapaio Digital - Sistema de Vendas e OS"
        Height="760" Width="1240" MinHeight="600" MinWidth="960"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="{DynamicResource BgMainBrush}"
        Foreground="{DynamicResource TextMainBrush}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="ColSidebar" Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0" Background="{DynamicResource BgSidebarBrush}">
            <DockPanel>
                <!-- Cabeçalho da Loja na Sidebar -->
                <StackPanel x:Name="PanelSidebarHeader" DockPanel.Dock="Top" Margin="14,16,14,14">
                    <Border Background="#1E293B" CornerRadius="8" Padding="8" Margin="0,0,0,10" ClipToBounds="True" MinHeight="68">
                        <Image x:Name="ImgSidebarLogo" MaxHeight="58" MaxWidth="190" Stretch="Uniform"
                               RenderOptions.BitmapScalingMode="HighQuality" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock x:Name="TxtSidebarLoja" Text="Sapaio Digital" Foreground="White" FontSize="15" FontWeight="Bold" TextWrapping="Wrap" TextAlignment="Center"/>
                    <TextBlock x:Name="TxtSidebarTelefone" Text="" Foreground="#94A3B8" FontSize="11.5" TextWrapping="Wrap" TextAlignment="Center" Margin="0,2,0,0"/>
                </StackPanel>

                <!-- Rodapé com Usuário Conectado -->
                <Border x:Name="PanelSidebarFooter" DockPanel.Dock="Bottom" Background="#1E293B" Padding="14,12" Margin="10,0,10,14" CornerRadius="8">
                    <StackPanel>
                        <TextBlock Text="OPERADOR CONECTADO" FontSize="10" Foreground="#94A3B8" FontWeight="Bold"/>
                        <TextBlock x:Name="TxtUsuarioConectado" Text="Admin" Foreground="White" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,2,0,0"/>
                        <TextBlock x:Name="TxtVersaoApp" Text="v1.0.3" Foreground="#94A3B8" FontSize="11" Margin="0,4,0,8"/>
                        <Button Content="Trocar Usuário" Style="{StaticResource SecondaryButton}" Padding="8,6" FontSize="11.5" Click="BtnTrocarUsuario_Click"/>
                    </StackPanel>
                </Border>

                <!-- Menu de Navegação -->
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Button x:Name="BtnNavPdv" Content="🛒  PDV (Vendas)" ToolTip="PDV (Vendas)" Style="{StaticResource SidebarButton}" Click="NavPdv_Click"/>
                        <Button x:Name="BtnNavOrc" Content="🔧  Orçamentos / OS" ToolTip="Orçamentos / OS" Style="{StaticResource SidebarButton}" Click="NavOrcamentos_Click"/>
                        <Button x:Name="BtnNavProd" Content="📦  Produtos e Estoque" ToolTip="Produtos e Estoque" Style="{StaticResource SidebarButton}" Click="NavProdutos_Click"/>
                        <Button x:Name="BtnNavCli" Content="👥  Clientes" ToolTip="Clientes" Style="{StaticResource SidebarButton}" Click="NavClientes_Click"/>
                        <Button x:Name="BtnNavRel" Content="📊  Relatórios" ToolTip="Relatórios" Style="{StaticResource SidebarButton}" Click="NavRelatorios_Click"/>
                        <Separator Background="#1E293B" Margin="14,10"/>
                        <Button x:Name="BtnNavUsu" Content="👤  Usuários" ToolTip="Usuários" Style="{StaticResource SidebarButton}" Click="NavUsuarios_Click"/>
                        <Button x:Name="BtnNavCfg" Content="🏪  Dados da Loja" ToolTip="Dados da Loja e Backup" Style="{StaticResource SidebarButton}" Click="NavConfiguracoes_Click"/>
                        <Button x:Name="BtnNavUpd" Content="🔄  Atualizações (GitHub)" ToolTip="Verificar e instalar atualizações do GitHub" Style="{StaticResource SidebarButton}" Click="NavConfiguracoes_Click"/>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- Conteúdo Principal -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="58"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,0,0,1" Padding="16,0,24,0">
                <DockPanel VerticalAlignment="Center">
                    <Button x:Name="BtnToggleSidebar" Content="☰" Style="{StaticResource SecondaryButton}" Padding="10,6" Margin="0,0,12,0"
                            ToolTip="Recolher/Expandir menu lateral" Click="BtnToggleSidebar_Click"/>
                    <TextBlock x:Name="TxtTituloPagina" Text="PDV — Ponto de Venda" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource TextMainBrush}"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>

                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button x:Name="BtnUpdateDisponivel" Content="⬇ Nova versão disponível!" Style="{StaticResource SuccessButton}"
                                Padding="10,6" FontSize="12" Margin="0,0,10,0" Visibility="Collapsed" Click="NavConfiguracoes_Click"/>
                        <Button x:Name="BtnToggleTema" Content="🌙 Tema Escuro" Style="{StaticResource SecondaryButton}" Padding="10,6" FontSize="12" Margin="0,0,14,0"
                                Click="BtnToggleTema_Click"/>
                        <TextBlock x:Name="TxtDataHoraTopo" VerticalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}" FontSize="12.5"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <ContentControl x:Name="MainContent" Grid.Row="1" Margin="16"/>
        </Grid>
    </Grid>
</Window>
